{
  "name": "plotlab-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @plotlab/web dev",
    "build": "pnpm --filter @plotlab/web build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "golden:approve": "UPDATE_GOLDEN=1 vitest run golden",
    "fixtures": "tsx golden/fixtures/make-fixtures.ts",
    "plotlab": "tsx packages/cli/src/main.ts"
  },
  "devDependencies": {
    "@plotlab/engine": "workspace:^",
    "@plotlab/machines": "workspace:^",
    "@plotlab/steps": "workspace:^",
    "@types/node": "^20.17.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
