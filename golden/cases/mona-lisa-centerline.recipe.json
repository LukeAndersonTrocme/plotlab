{
  "schemaVersion": 2,
  "input": "image",
  "target": { "kind": "plotter" },
  "paper": { "widthMm": 210, "heightMm": 297 },
  "layout": { "fit": "fit", "marginMm": 20, "position": [0.5, 0.5] },
  "inks": [{ "id": "black", "name": "Black", "color": "#111111", "mix": "multiply", "widthMm": 0.3 }],
  "machine": "generic",
  "steps": [
    { "step": "threshold", "version": 2, "params": { "mode": "fixed", "level": 30 } },
    { "step": "centerline", "version": 2, "params": { "minLength": 1.7, "smoothing": 0.28 } },
    { "step": "order", "version": 2, "params": { "method": "nearest" } }
  ],
  "fixture": "mona-lisa-600.jpg"
}
